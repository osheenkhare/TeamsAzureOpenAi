
# =============================================================================
# Environment Configuration Example
# =============================================================================
#
# This file contains the environment variables required to run the application.
#
# Setup Instructions:
# 1. Copy this file and rename it to .env
# 2. Update the placeholder values with your actual credentials.
# 3. Ensure .env is added to .gitignore to protect sensitive information.
#
# IMPORTANT:
# - Never commit actual API keys or client secrets to version control.
# - Keep .env.example updated whenever new environment variables are added.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Azure OpenAI Configuration
# -----------------------------------------------------------------------------
# Configure Azure OpenAI credentials.
# These values can be provisioned from Azure AI Foundry.
#
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com/openai/v1"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-5.4-mini"


# -----------------------------------------------------------------------------
# Microsoft Teams Configuration
# -----------------------------------------------------------------------------
# Configure Microsoft Teams application authentication.
# These values can be provisioned through Microsoft Entra ID / Teams CLI.
#
CLIENT_ID="your-client-id"
CLIENT_SECRET="your-client-secret"
TENANT_ID="your-tenant-id"


# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Enable or disable socket mode for the agent.
# true  = Enable socket mode
# false = Disable socket mode
#
USE_SOCKET_MODE=true